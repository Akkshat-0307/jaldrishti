# ==============================================================================
# JalDrishti Environment Configuration Template
# Copy this file to .env or configure in your deployment dashboard (Vercel / Render / Fly)
# NEVER commit real credentials, tokens, or private keys to the repository!
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Operational Mode & Reliability
# ------------------------------------------------------------------------------
# Set to 1 for demo mode: serves pre-computed satellite & GIS artifacts with zero network
# Required for zero-connectivity offline operation. Default: 1
DEMO_MODE=1

# Date stamp of the active disaster scenario (Assam Cachar June 2022)
DATA_VERSION=2026-11-21

# Path to the data directory containing event artifacts
# Local default: ../../data or ./data | Container default: /app/data
DATA_DIR=./data

# ------------------------------------------------------------------------------
# 2. Pipeline & Earth Engine (Pipeline scripts only - NOT needed for web/api)
# ------------------------------------------------------------------------------
# Google Cloud project enabled with Google Earth Engine API
# Credentials are authenticated via 'earthengine authenticate'
EE_PROJECT=your-gcp-project-id

# ------------------------------------------------------------------------------
# 3. Web & API Endpoints
# ------------------------------------------------------------------------------
# Public URL of the FastAPI backend for browser EventSource and direct REST calls.
# Examples:
#   Local dev:    http://127.0.0.1:8000
#   Production:   https://jaldrishti-api.onrender.com (or https://jaldrishti-api.fly.dev)
# If left empty, Next.js proxies through its internal /api rewrite route.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Server-side API destination for Next.js rewrites (used in Docker Compose / Kubernetes)
API_URL=http://127.0.0.1:8000

# Port bindings
PORT=8000
NODE_ENV=production

# ------------------------------------------------------------------------------
# 4. Rescue Beacon PWA Configuration
# ------------------------------------------------------------------------------
# Clearly fake placeholder phone number used for simulated SMS emergency fallback.
# For simulation only. Does NOT connect to official 1077 emergency services.
NEXT_PUBLIC_DEMO_SMS_NUMBER=+91 00000 00000
